# cp .env.example .env && chmod 600 .env, then replace every REPLACE_ME. Never commit .env.
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_CORE_PORT=8420
MEMORY_CORE_VOLUME=tdai-memory-core-data
MEMORY_CORE_GATEWAY_API_KEY=

# LLM used by Core for L1/L2/L3 extraction (must accept non-streaming chat/completions)
MEMORY_LLM_BASE_URL=REPLACE_ME
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME
MEMORY_PROMPT_MODE=code

# Shared secret between Core and embed-svc, e.g.:  openssl rand -hex 24
EMBED_API_KEY=REPLACE_ME
EMBED_MODEL_DIR=./models/bge-small-zh-v1.5
EMBED_PORT=8090
EMBED_THREADS=4
CACHE_MAX_MB=64
CACHE_MAX_ENTRIES=200000
CACHE_TTL_SECS=0
# embed-svc tuning / hardening (defaults in parentheses). BIND_ADDR is
# 0.0.0.0 in the container so Docker port mapping works; the host port
# stays loopback-only in docker-compose.yml. Do not publish it publicly.
# MAX_TOKENS_PER_RUN=8192
# MAX_BODY_MB=4
# RATE_LIMIT_PER_MIN=0
# HEALTH_EXIT_ON_UNHEALTHY=false

# Optional: Panel UI + Knowledge service (memory-hub). Needs a .admin-key (run init-admin.sh first).
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
# MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
# MEMORY_HUB_VOLUME=tdai-panel-data

# Optional: LLM request proxy (memory-proxy). Also needs proxy-config.yaml, see README.
PROXY_PORT=8096
# MEMORY_PROXY_IMAGE=memory-proxy:local
# MEMORY_PROXY_VOLUME=tdai-proxy-data
